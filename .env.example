# Copy values into Secret Manager — never commit real secrets.
GMAIL_USER_EMAIL=itdocumentation@forbesmarshall.com
EMAIL_SUBJECT=FM Orders Bulletin
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-pro-preview
GEMINI_THINKING_LEVEL=high
# Template rows per Gemini call - smaller replies cannot hit the output token ceiling
GEMINI_ROW_BATCH=25
GEMINI_MAX_OUTPUT_TOKENS=65535
GOOGLE_SHEET_ID=
TEMPLATE_SHEET_ID=17YLBsDFyJ3ejKc3y12hNd6mb1htcwovRR0lXiUrux4U
TEMPLATE_WORKSHEET_NAME=Template
TEMPLATE_WORKSHEET_GID=1145057086
TEMPLATE_MONTH_HEADER_CELL=X2
# Shared Drive (or folder inside one) holding the monthly files. A My Drive folder does not
# work: the service account has no storage quota, so file creation fails there.
# The service account must be a Content Manager on the Shared Drive.
DRIVE_PARENT_FOLDER_ID=0AFfpBsQN7VH4Uk9PVA
# Only needed when writing to My Drive via domain-wide delegation instead of a Shared Drive
DRIVE_IMPERSONATE_USER=
MONTHLY_FILE_SHARE_EMAILS=
MONTHLY_TAB_SUFFIX=_order_bulletin
# Link notification: needs the gmail.send scope on domain-wide delegation
NOTIFY_EMAILS=bssali@forbesmarshall.com
NOTIFY_FROM_EMAIL=itdocumentation@forbesmarshall.com
GOOGLE_SERVICE_ACCOUNT_JSON=
